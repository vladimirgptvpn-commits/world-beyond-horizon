{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Beyond Horizon Society State v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "seed",
    "regionId",
    "turn",
    "player",
    "regions",
    "npcs",
    "contracts",
    "ledger",
    "events",
    "activeThreat"
  ],
  "properties": {
    "version": {
      "const": "0.3.0"
    },
    "seed": {
      "type": "string"
    },
    "regionId": {
      "type": "string",
      "minLength": 1
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "player": {
      "type": "object",
      "required": [
        "health",
        "combat",
        "coins",
        "injuries"
      ],
      "properties": {
        "health": {
          "type": "integer",
          "minimum": 0
        },
        "combat": {
          "type": "integer",
          "minimum": 0
        },
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "injuries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "peacefulShare",
          "hazard",
          "crime",
          "oppression",
          "protection",
          "routes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "peacefulShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "hazard": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crime": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "oppression": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "protection": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "npcs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name",
          "regionId",
          "health",
          "coins",
          "combat",
          "relationship",
          "traits",
          "stance",
          "goals",
          "knowledge",
          "memory"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "regionId": {
            "type": "string"
          },
          "health": {
            "type": "integer",
            "minimum": 0
          },
          "coins": {
            "type": "integer",
            "minimum": 0
          },
          "combat": {
            "type": "integer",
            "minimum": 0
          },
          "relationship": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "traits": {
            "type": "object",
            "required": [
              "greed",
              "aggression",
              "empathy",
              "caution",
              "honesty"
            ],
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "stance": {
            "enum": [
              "peaceful",
              "adverse"
            ]
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memory": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "activeThreat": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "npcId",
            "demand",
            "from",
            "since"
          ],
          "properties": {
            "npcId": {
              "type": "string"
            },
            "demand": {
              "type": "integer",
              "minimum": 1
            },
            "from": {
              "type": "string"
            },
            "since": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
