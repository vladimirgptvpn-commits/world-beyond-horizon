{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adventure Save",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "save_id", "world_id", "world_revision", "character", "world", "player_location_id"],
  "properties": {
    "format_version": {"const": "0.1.0"},
    "save_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "world_revision": {"type": "integer", "minimum": 0},
    "character": {"$ref": "character.schema.json"},
    "world": {"$ref": "world.schema.json"},
    "player_location_id": {"type": "string", "minLength": 1},
    "pending_consequences": {"type": "array", "items": {"type": "object"}},
    "saved_at": {"type": "string", "format": "date-time"}
  }
}
